#!/bin/sh
# ===========================================================================
#  commit-msg: the AI-Provider line is a RED LINE, not a formality.
#
#  Why a red line: every file here is AI-authored (AI-ONLY.md). A commit that
#  does not say WHICH model wrote it makes the change unattributable -- a reviewer
#  cannot ask that model 'why is this here', and cannot compare behaviour across
#  models when something breaks. Attribution is the whole point of AI-ONLY.
#
#  TWO LAYERS, and this one is advisory:
#    1. THIS HOOK  -- only runs if the contributor ran
#                     git config core.hooksPath .githooks
#                     Skipping that config bypasses this entirely.
#    2. CI         -- .github/workflows/provenance.yml runs on GitHub's side and
#                     cannot be skipped. That is what makes it a real red line.
#
#  This hook exists for fast feedback, not for enforcement.
#
#  ENABLE:  git config core.hooksPath .githooks
# ===========================================================================

msg_file="$1"

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then exit 0; fi
fi

line=$(grep -iE "^AI-Provider:" "$msg_file" | head -1)

if [ -z "$line" ]; then
  echo ""
  echo "  [RECHAZADO] 缺少 AI-Provider 声明 —— 这是红线。"
  echo ""
  echo "  必须写明是哪个模型写的本提交。格式："
  echo "      AI-Provider: Claude"
  echo "      AI-Provider: GPT-5"
  echo "      AI-Provider: Copilot"
  echo "      AI-Provider: Qwen2.5-Coder-32B (local)"
  echo ""
  echo "  没有这一行 = 无法追溯 = 违规。见 AI-ONLY.md"
  echo ""
  exit 1
fi

value=$(echo "$line" | sed "s/^[Aa][Ii]-[Pp]rovider:[[:space:]]*//" | sed "s/[[:space:]]*$//")
lower=$(echo "$value" | tr "A-Z" "a-z")
if [ ${#value} -lt 2 ]; then
  echo ""
  echo "  [RECHAZADO] AI-Provider 的值太短。写真实模型名。"
  echo ""
  exit 1
fi
case "$lower" in
  unknown|none|n/a|na|todo|tbd|xxx|x|test|placeholder|ai|model)
    echo ""
    echo "  [RECHAZADO] AI-Provider 是占位符：\"$value\""
    echo "  这条要能回答「出问题时该去问谁」，写真实模型名。"
    echo ""
    exit 1
    ;;
esac

exit 0
